//Mekanism Chemical Oxidizer Recipes

mods.mekanism.chemical.oxidizer.removeRecipe(<gas:sodium>);
mods.mekanism.chemical.oxidizer.removeRecipe(<gas:lithium>);
mods.mekanism.chemical.oxidizer.removeRecipe(<gas:lithium>);
mods.mekanism.chemical.oxidizer.removeRecipe(<gas:sulfurdioxide>);
mods.mekanism.chemical.oxidizer.addRecipe(<minecraft:flint>, <gas:oxygen> * 1000);
mods.mekanism.chemical.oxidizer.addRecipe(<ore:dustSodium>, <gas:sodium> * 1000);
mods.mekanism.chemical.oxidizer.addRecipe(<ore:dustLithium>, <gas:lithium> * 1000);
mods.mekanism.chemical.oxidizer.addRecipe(<ore:dustSulfur>, <gas:sulfurdioxide> * 1000);